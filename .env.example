# Copy to `.env.local` only if you need Next.js-specific public values.
# Mercado Pago credentials and other secrets MUST live in `.dev.vars`
# (local) or Cloudflare Worker secrets (production). Never commit them.
#
# See `.dev.vars.example` for the full list used by the Worker / `next dev`
# via OpenNext (`initOpenNextCloudflareForDev`).

# Public site URL used in checkout return URLs. Prefer setting APP_URL in
# `.dev.vars` (local) or wrangler `vars` (deployed). This is a fallback for
# tooling that reads Next env files.
APP_URL=http://localhost:3000
