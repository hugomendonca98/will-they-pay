{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "will-they-pay",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "will-they-pay",
    },
  ],
  // Non-secret configuration. Override per environment as needed.
  // Secrets (MERCADOPAGO_ACCESS_TOKEN, MERCADOPAGO_WEBHOOK_SECRET) must be
  // set with `wrangler secret put` and never committed here.
  "vars": {
    "APP_URL": "http://localhost:3000",
    "MERCADOPAGO_SANDBOX": "true",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "will-they-pay",
      // Placeholder — not a real Cloudflare resource. After
      // `pnpm wrangler d1 create will-they-pay`, replace this with the
      // printed database_id (or set CLOUDFLARE_D1_DATABASE_ID in your shell
      // / CI secrets and keep this placeholder locally).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
}
